<!DOCTYPE html><html lang="en" style=""><head><meta charset="utf-8"><meta content="width=device-width, initial-scale=1.0" name="viewport"><meta content="web_dashboard" name="shell-type"><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"><link href="https://fonts.googleapis.com" rel="preconnect"><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"><style>@layer base { html, body { margin: 0; padding: 0; } body { overscroll-behavior: none; } main > :first-child { margin-top: 0 !important; } main > :last-child { margin-bottom: 0 !important; } } ::-webkit-scrollbar { display: none; }</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config = { darkMode: "class", theme: { extend: { "colors": { "secondary-container": "#86f2e4", "tertiary": "#860025", "on-tertiary-fixed": "#40000d", "error": "#ba1a1a", "tertiary-fixed-dim": "#ffb2b7", "primary-fixed-dim": "#b0c6ff", "surface-variant": "#d3e4fe", "on-surface": "#0b1c30", "on-primary-container": "#bcceff", "surface-container-high": "#dce9ff", "on-tertiary-fixed-variant": "#920029", "on-secondary-fixed-variant": "#005049", "secondary-fixed-dim": "#6bd8cb", "secondary-fixed": "#89f5e7", "on-primary": "#ffffff", "surface-dim": "#cbdbf5", "tertiary-fixed": "#ffdadb", "outline": "#737784", "tertiary-container": "#b20035", "primary": "#003c90", "on-secondary-container": "#006f66", "inverse-primary": "#b0c6ff", "on-secondary-fixed": "#00201d", "on-tertiary": "#ffffff", "primary-container": "#0f52ba", "on-secondary": "#ffffff", "surface-container-low": "#eff4ff", "surface-container-highest": "#d3e4fe", "on-error": "#ffffff", "surface-container-lowest": "#ffffff", "background": "#f8f9ff", "on-primary-fixed-variant": "#00419c", "surface-tint": "#1d59c1", "inverse-on-surface": "#eaf1ff", "surface-container": "#e5eeff", "on-error-container": "#93000a", "on-primary-fixed": "#001945", "on-background": "#0b1c30", "inverse-surface": "#213145", "surface": "#f8f9ff", "secondary": "#006a61", "outline-variant": "#c3c6d5", "primary-fixed": "#d9e2ff", "on-tertiary-container": "#ffbec1", "error-container": "#ffdad6", "surface-bright": "#f8f9ff", "on-surface-variant": "#434653" }, "borderRadius": { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" }, "spacing": { "space-xs": "0.25rem", "gutter-desktop": "1.5rem", "space-xl": "2.5rem", "gutter": "1rem", "space-sm": "0.5rem", "margin-desktop": "2rem", "space-md": "1rem", "space-lg": "1.5rem", "margin": "1rem" }, "fontFamily": { "body-md": ["Inter"], "label-lg": ["Inter"], "headline-md": ["Plus Jakarta Sans"], "unit-indicator": ["JetBrains Mono"], "headline-lg": ["Plus Jakarta Sans"], "label-md": ["Inter"], "label-sm": ["Inter"], "body-lg": ["Inter"], "body-sm": ["Inter"], "metric-display": ["JetBrains Mono"], "headline-lg-mobile": ["Plus Jakarta Sans"], "headline-sm": ["Plus Jakarta Sans"] }, "fontSize": { "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }], "label-lg": ["14px", { "lineHeight": "18px", "fontWeight": "600" }], "headline-md": ["22px", { "lineHeight": "28px", "fontWeight": "600" }], "unit-indicator": ["12px", { "lineHeight": "16px", "fontWeight": "600" }], "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "700" }], "label-md": ["12px", { "lineHeight": "16px", "fontWeight": "500" }], "label-sm": ["11px", { "lineHeight": "14px", "fontWeight": "500" }], "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }], "body-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }], "metric-display": ["28px", { "lineHeight": "32px", "fontWeight": "700" }], "headline-lg-mobile": ["26px", { "lineHeight": "34px", "fontWeight": "700" }], "headline-sm": ["18px", { "lineHeight": "24px", "fontWeight": "600" }] } } } };</script></head><body class="bg-background font-body-md text-body-md text-on-surface"><div class=""><main class="relative bg-background w-full min-h-screen px-gutter-desktop py-space-lg flex"><div class="flex flex-col w-full max-w-xl mx-auto gap-4 py-4">
  <!-- Compact Header Banner -->
  <div class="bg-surface-container-lowest rounded-lg p-4 shadow-sm flex items-center justify-between border border-outline-variant/30">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-surface-container-high overflow-hidden shrink-0">
        <img class="w-full h-full object-cover" alt="Eleanor Vance Sterling" src="https://lh3.googleusercontent.com/aida-public/AB6AXuATZhL5BiLhbAyuB3qcYCtp_Iaq-dQokM4MZkaY_npWHMYjoP6kH4hJDz9be-MOnxF7i_NETTzBJj7KQff6V2MQkBJRKYr8bJBlx9_t5UL42di02uwrQeYeh3khwFRcONFP4g7F2-1u1O1jd6JN26HaLjqdSi8olQSwODKbcJjiCSlM4odx-RGYgMm1JGytTVk3EcYOo6aQd6tOYXz7yc4E23M0JRtRIAMp3rLn8Y03xF83EUDfmm1g">
      </div>
      <div>
        <h1 class="text-sm font-semibold text-on-surface">Eleanor Vance Sterling</h1>
        <p class="text-xs text-on-surface-variant">PT-90412 • Age 35 (F) • Urgent Care</p>
      </div>
    </div>
    <span class="text-xs px-2 py-0.5 rounded bg-surface-container text-on-surface-variant font-medium">#MED-9402</span>
  </div>

  <form action="${pageContext.request.contextPath}/nurse" method="POST" id="clinicalIntakeForm" class="flex flex-col gap-4">
  
    <div class="bg-surface-container-lowest rounded-lg p-4 shadow-sm border border-outline-variant/30 flex flex-col gap-3">
      <div class="flex items-center justify-between border-b border-outline-variant/20 pb-2">
        <h2 class="text-xs font-bold text-on-surface uppercase tracking-wide">1. Demographics &amp; Identification</h2>
        <span class="text-[11px] text-error font-medium">* Required</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Full Name <span class="text-error">*</span></label>
          <input class="w-full px-2.5 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="fullName" required="" type="text" value="Eleanor Vance Sterling" placeholder="Full legal name">
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Email <span class="text-error">*</span></label>
          <input class="w-full px-2.5 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="email" required="" type="email" value="e.vance@examplehealth.org" placeholder="name@example.com">
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Phone Number <span class="text-error">*</span></label>
          <input class="w-full px-2.5 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="phoneNumber" required="" type="tel" value="+1 (555) 234-5678" placeholder="+1 (555) 000-0000">
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">SSN / National ID <span class="text-error">*</span></label>
          <input class="w-full px-2.5 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="socialNumber" required="" type="text" value="••• - •• - 4829" placeholder="XXX-XX-XXXX">
        </div>
      </div>
      <!-- Insurance Compact Switch -->
      <div class="pt-1 border-t border-outline-variant/10 flex items-center justify-between text-xs">
        <span class="font-medium text-on-surface">Health Insurance:</span>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-1.5 cursor-pointer text-xs">
            <input checked="" name="healthInsurance" type="radio" value="0" class="accent-primary text-xs">
            <span class="text-on-surface">Active Coverage</span>
          </label>
          <label class="flex items-center gap-1.5 cursor-pointer text-xs">
            <input name="healthInsurance" type="radio" value="false" class="accent-primary text-xs">
            <span class="text-on-surface-variant">Self-Pay</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Section 2: Vitals -->
    <div class="bg-surface-container-lowest rounded-lg p-4 shadow-sm border border-outline-variant/30 flex flex-col gap-3">
      <div class="flex items-center justify-between border-b border-outline-variant/20 pb-2">
        <h2 class="text-xs font-bold text-on-surface uppercase tracking-wide">2. Baseline Vitals</h2>
        <span class="text-[11px] text-secondary font-medium">Resting State</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Blood Pressure</label>
          <div class="relative flex items-center">
            <input class="w-full pl-2.5 pr-12 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="bloodPressure" type="text" value="120">
            <span class="absolute right-2 text-[10px] text-outline font-medium">mmHg</span>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Heart Rate</label>
          <div class="relative flex items-center">
            <input class="w-full pl-2.5 pr-10 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="heartRate" type="number" value="72">
            <span class="absolute right-2 text-[10px] text-outline font-medium">bpm</span>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Body Temp</label>
          <div class="relative flex items-center">
            <input class="w-full pl-2.5 pr-8 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="bodyTemperature" type="text" value="98">
            <span class="absolute right-2 text-[10px] text-outline font-medium">°F</span>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Resp. Rate</label>
          <div class="relative flex items-center">
            <input class="w-full pl-2.5 pr-14 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="respiratoryRate" type="number" value="16">
            <span class="absolute right-2 text-[10px] text-outline font-medium">breaths/m</span>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Weight</label>
          <div class="relative flex items-center">
            <input class="w-full pl-2.5 pr-8 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="weight" type="number" step="0.1" value="68">
            <span class="absolute right-2 text-[10px] text-outline font-medium">kg</span>
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Height</label>
          <div class="relative flex items-center">
            <input class="w-full pl-2.5 pr-8 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="height" type="number" step="0.5" value="175">
            <span class="absolute right-2 text-[10px] text-outline font-medium">cm</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 3: Optional Medical Condition Disclosure -->
    <div class="bg-surface-container-lowest rounded-lg p-4 shadow-sm border border-outline-variant/30 flex flex-col gap-3">
      <label class="flex items-center gap-2 cursor-pointer select-none text-xs font-medium text-on-surface">
        <input id="conditionCheckbox" checked="" class="accent-primary rounded" type="checkbox" onchange="document.getElementById('conditionDetails').classList.toggle('hidden', !this.checked)">
        <span class="">Add Medical Condition &amp; Treatment (Optional)</span>
      </label>
      <div id="conditionDetails" class="flex flex-col gap-3 pt-2 border-t border-outline-variant/20">
        <div class="flex flex-col gap-1">
          <label class="text-xs font-medium text-on-surface">Condition / Diagnosis Name</label>
          <input class="w-full px-2.5 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="name" type="text" value="Type 2 Diabetes Mellitus (E11.9)" placeholder="e.g. Type 2 Diabetes, Hypertension">
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-on-surface">Clinical State</label>
            <select name="state" class="w-full px-2.5 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none">
              <option selected="" value="Stable / Managed">Stable / Managed</option>
              <option value="Guarded / Under Evaluation">Guarded / Under Evaluation</option>
              <option value="Acute / Critical">Acute / Critical</option>
              <option value="Remission / Convalescent">Remission / Convalescent</option>
              <option value="Chronic Ongoing">Chronic Ongoing</option>
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-xs font-medium text-on-surface">Current Treatments &amp; Regimens</label>
            <input class="w-full px-2.5 py-1.5 bg-surface-container-low rounded-md text-xs text-on-surface border border-transparent focus:border-primary focus:bg-surface-container-lowest focus:outline-none" name="currentTreatments" type="text" value="Metformin 500mg PO BID; Lisinopril 10mg" placeholder="Medications, dosages, frequency">
          </div>
        </div>
      </div>
    </div>

    <!-- Clean Actions Footer -->
    <div class="flex items-center justify-end gap-2 pt-1">
      <button type="reset" class="px-3 py-1.5 rounded-md bg-surface-container text-xs font-medium text-on-surface hover:bg-surface-container-high transition-colors">
        Clear
      </button>
      <button type="submit" class="px-4 py-1.5 rounded-md bg-primary text-xs font-medium text-on-primary hover:bg-primary-container transition-colors shadow-sm">
        Submit Intake Form
      </button>
    </div>
  </form>
</div>
<script>
  // SSN Privacy Mask Toggle
  let ssnMasked = true;
  function toggleSsnMask() {
    const input = document.getElementById('ssnInput');
    const icon = document.getElementById('ssnIcon');
    if (ssnMasked) {
      input.type = 'text';
      input.value = '142 - 08 - 4829';
      icon.textContent = 'visibility_off';
      ssnMasked = false;
    } else {
      input.type = 'password';
      input.value = '••• - •• - 4829';
      icon.textContent = 'visibility';
      ssnMasked = true;
    }
  }

  // Insurance status view helper
  function updateInsuranceView(isCovered) {
    const badge = document.getElementById('insuranceDetailBadge');
    if (isCovered) {
      badge.innerHTML = `
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px] text-secondary">check_circle</span>
          Pre-authorization on file: Copay $25.00 / In-Network Cardiology
        </span>
        <span class="font-unit-indicator text-unit-indicator text-outline">EXP: 12/2026</span>
      `;
    } else {
      badge.innerHTML = `
        <span class="flex items-center gap-1 text-tertiary">
          <span class="material-symbols-outlined text-[16px]">priority_high</span>
          Self-Pay selected: Patient billing agreement form dispatched to intake tablet.
        </span>
        <span class="font-unit-indicator text-unit-indicator text-tertiary">UNVERIFIED</span>
      `;
    }
  }

  // Temperature unit switch
  let currentTempUnit = 'F';
  function setTempUnit(unit) {
    if (currentTempUnit === unit) return;
    currentTempUnit = unit;
    const btnF = document.getElementById('tempUnitF');
    const btnC = document.getElementById('tempUnitC');
    const input = document.getElementById('tempInput');
    const label = document.getElementById('tempUnitLabel');
    const ref = document.getElementById('tempRefText');

    if (unit === 'C') {
      btnC.className = "px-2 py-0.5 rounded-md bg-surface-container-lowest shadow-sm text-on-surface font-bold";
      btnF.className = "px-2 py-0.5 rounded-md text-outline hover:text-on-surface font-semibold";
      input.value = "37.0";
      label.textContent = "°C";
      ref.textContent = "Normothermic (36.5°C - 37.3°C)";
    } else {
      btnF.className = "px-2 py-0.5 rounded-md bg-surface-container-lowest shadow-sm text-on-surface font-bold";
      btnC.className = "px-2 py-0.5 rounded-md text-outline hover:text-on-surface font-semibold";
      input.value = "98.6";
      label.textContent = "°F";
      ref.textContent = "Normothermic (97.8°F - 99.1°F)";
    }
  }

  // Weight unit switch
  let currentWeightUnit = 'kg';
  function setWeightUnit(unit) {
    if (currentWeightUnit === unit) return;
    currentWeightUnit = unit;
    const btnKg = document.getElementById('weightUnitKg');
    const btnLbs = document.getElementById('weightUnitLbs');
    const input = document.getElementById('weightInput');
    const label = document.getElementById('weightUnitLabel');
    const equiv = document.getElementById('weightEquiv');

    if (unit === 'lbs') {
      btnLbs.className = "px-2 py-0.5 rounded-md bg-surface-container-lowest shadow-sm text-on-surface font-bold";
      btnKg.className = "px-2 py-0.5 rounded-md text-outline hover:text-on-surface font-semibold";
      input.value = "150.0";
      label.textContent = "LBS";
      equiv.textContent = "Equiv: 68.0 kg";
    } else {
      btnKg.className = "px-2 py-0.5 rounded-md bg-surface-container-lowest shadow-sm text-on-surface font-bold";
      btnLbs.className = "px-2 py-0.5 rounded-md text-outline hover:text-on-surface font-semibold";
      input.value = "68.0";
      label.textContent = "KG";
      equiv.textContent = "Equiv: 149.9 lbs";
    }
    calculateBMI();
  }

  // Height unit switch
  let currentHeightUnit = 'cm';
  function setHeightUnit(unit) {
    if (currentHeightUnit === unit) return;
    currentHeightUnit = unit;
    const btnCm = document.getElementById('heightUnitCm');
    const btnFt = document.getElementById('heightUnitFt');
    const input = document.getElementById('heightInput');
    const label = document.getElementById('heightUnitLabel');
    const equiv = document.getElementById('heightEquiv');

    if (unit === 'ft') {
      btnFt.className = "px-2 py-0.5 rounded-md bg-surface-container-lowest shadow-sm text-on-surface font-bold";
      btnCm.className = "px-2 py-0.5 rounded-md text-outline hover:text-on-surface font-semibold";
      input.value = "5.75";
      label.textContent = "FT";
      equiv.textContent = "Equiv: 175.0 cm";
    } else {
      btnCm.className = "px-2 py-0.5 rounded-md bg-surface-container-lowest shadow-sm text-on-surface font-bold";
      btnFt.className = "px-2 py-0.5 rounded-md text-outline hover:text-on-surface font-semibold";
      input.value = "175";
      label.textContent = "CM";
      equiv.textContent = "Equiv: 5' 9\"";
    }
    calculateBMI();
  }

  // Automatic BMI Calculation
  function calculateBMI() {
    let weightKg = parseFloat(document.getElementById('weightInput').value) || 0;
    if (currentWeightUnit === 'lbs') {
      weightKg = weightKg * 0.45359237;
    }

    let heightCm = parseFloat(document.getElementById('heightInput').value) || 0;
    if (currentHeightUnit === 'ft') {
      heightCm = heightCm * 30.48;
    }

    if (weightKg > 0 && heightCm > 0) {
      const heightM = heightCm / 100;
      const bmi = (weightKg / (heightM * heightM)).toFixed(1);
      const bmiDisplay = document.getElementById('bmiDisplay');
      const bmiCategory = document.getElementById('bmiCategory');
      
      bmiDisplay.textContent = bmi;

      if (bmi < 18.5) {
        bmiCategory.textContent = "Underweight Range (Ref: < 18.5)";
        bmiCategory.className = "font-label-md text-label-md text-tertiary font-semibold";
      } else if (bmi <= 24.9) {
        bmiCategory.textContent = "Healthy Normal Weight (Reference: 18.5 - 24.9)";
        bmiCategory.className = "font-label-md text-label-md text-secondary font-semibold";
      } else if (bmi <= 29.9) {
        bmiCategory.textContent = "Overweight Range (Reference: 25.0 - 29.9)";
        bmiCategory.className = "font-label-md text-label-md text-primary font-semibold";
      } else {
        bmiCategory.textContent = "Obesity Range (Reference: >= 30.0)";
        bmiCategory.className = "font-label-md text-label-md text-tertiary font-semibold";
      }
    }
  }

  // Section 3: Conditional Medical Disclosure Toggle
  let isDisclosureExpanded = true;
  function toggleTreatmentDisclosure() {
    const checkbox = document.getElementById('conditionCheckbox');
    checkbox.checked = !checkbox.checked;
    handleCheckboxChange(checkbox.checked);
  }

  function handleCheckboxChange(checked) {
    const container = document.getElementById('conditionalDisclosureBody');
    const chevron = document.getElementById('expandChevron');
    const badge = document.getElementById('triggerStatusBadge');

    if (checked) {
      container.classList.remove('hidden');
      chevron.classList.add('rotate-180');
      badge.textContent = 'DISCLOSURE ACTIVE';
      badge.className = 'font-unit-indicator text-unit-indicator text-primary bg-primary-fixed px-space-xs py-0.5 rounded font-semibold';
    } else {
      container.classList.add('hidden');
      chevron.classList.remove('rotate-180');
      badge.textContent = 'NO ACTIVE CONDITIONS DISCLOSED';
      badge.className = 'font-unit-indicator text-unit-indicator text-outline bg-surface-container px-space-xs py-0.5 rounded font-semibold';
    }
  }

  // Medical State Pill interactive style toggle
  function updateStatePill(radioInput) {
    const allLabels = radioInput.closest('.grid').querySelectorAll('label');
    allLabels.forEach(lbl => {
      lbl.className = 'relative flex flex-col items-center justify-center p-space-sm rounded-xl cursor-pointer bg-surface-container-low hover:bg-surface-container transition-all text-center';
    });
    
    // Highlight the selected card with primary container / active styling
    const parentLabel = radioInput.closest('label');
    parentLabel.className = 'relative flex flex-col items-center justify-center p-space-sm rounded-xl cursor-pointer bg-secondary-container/30 shadow-sm transition-all text-center';
  }

  // Refresh Telemetry Mock
  function refreshVitalsTele() {
    const bpSys = document.getElementById('bpSystolic');
    const bpDia = document.getElementById('bpDiastolic');
    // slight variation simulation
    bpSys.value = Math.floor(118 + Math.random() * 5);
    bpDia.value = Math.floor(78 + Math.random() * 4);
